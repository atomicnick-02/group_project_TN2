<mujoco model="double_pendulum">
  <option timestep="0.002" integrator="RK4" gravity="0 0 -9.81"/>

  <default>
    <joint type="hinge" axis="0 1 0"/>
    <geom type="capsule" rgba="0.3 0.5 0.9 1"/>
  </default>

  <worldbody>
    <camera name="side" pos="0 0.4 0.1" mode="targetbody" target="link1"/> 
    <body name="link1" pos="0 0 0.2">
      <joint name="q1"
             damping="7.634058385430087e-12"
             frictionloss="0.00305"
             armature="0"/>
      <inertial pos="0 0 -0.05" mass="0.10548177618443695"
                diaginertia="0.00046166221821039165 0.00046166221821039165 1e-6"/> <!-- Why is the diaginertial like this? -->
      <geom fromto="0 0 0  0 0 -0.05" size="0.004"/>

      <body name="link2" pos="0 0 -0.05">
        <joint name="q2"
               damping="0.0005106535523065844"
               frictionloss="0.0007777"
               armature="0"/>
        <inertial pos="0 0 -0.03670036749567022" mass="0.07619744360415454"
                  diaginertia="0.00023702395072092597 0.00023702395072092597 1e-6"/>
        <geom fromto="0 0 0  0 0 -0.05" size="0.004"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="u1" joint="q1" gear="1" ctrlrange="-0.1 0.1" ctrllimited="true"/>
    <motor name="u2" joint="q2" gear="1" ctrlrange="-0.1 0.1" ctrllimited="true"/>
  </actuator>
</mujoco>

